#!/bin/sh
#---------------------------------------------
#   xdg-terminal
#
#   Utility script to open the registered terminal emulator
#
#   Refer to the usage() function below for usage.
#
#   Copyright 2009-2010, Fathi Boudra <fabo@freedesktop.org>
#   Copyright 2009-2010, Rex Dieter <rdieter@fedoraproject.org>
#   Copyright 2006, Kevin Krammer <kevin.krammer@gmx.at>
#   Copyright 2026, Slatian <baschdel@disroot.org>
#
#   LICENSE:
#
#---------------------------------------------

manualpage()
{
cat << '_MANUALPAGE'
_MANUALPAGE
}

usage()
{
cat << '_USAGE'
_USAGE
}

XDG_UTILS_ENABLE_DOUBLE_HYPEN="y"

#@xdg-utils-common@

FORCE_NEW_TERMINAL="y"
TERMINAL_TITLE=""
APP_ID=""

while [ "$#" -gt 0 ]; do
	case "$1" in
		--allow-terminal-reuse)
			FORCE_NEW_TERMINAL=""
			shift
			;;

		--title=*)
			TERMINAL_TITLE="${1#--title=}"
			shift
			;;

		--app-id=*)
			APP_ID="${1#--app-id=}"
			shift
			;;

		--)
			shift
			break
			;;
		
		-*)
			exit_failure_syntax "Unknown option: $1"
			;;
		
		*)
			break
			;;
	esac
done

FLAGS=""
if [ -n "$TERMINAL_TITLE" ] ; then
	FLAGS="t"
fi
if [ -n "$APP_ID" ] ; then
	FLAGS="${FLAGS}a"
fi

# Start trying to launch terminals

if [ -z "$FORCE_NEW_TERMINAL" ] && test -t 1 ; then
	DEBUG 1 "We already are on a terminal, executing command directly."
	"$@"
	exit $?
elif command -v xdg-terminal-exec >/dev/null 2>/dev/null ; then
	DEBUG 1 "Using xdg-terminal-exec"
	case "$FLAGS" in
		t)
			xdg-terminal-exec --title="$TERMINAL_TITLE" -- "$@"
			;;
		a)
			xdg-terminal-exec --app-id="$APP_ID" -- "$@"
			;;
		ta)
			xdg-terminal-exec --app-id="$APP_ID" --title="$TERMINAL_TITLE" -- "$@"
			;;
		*)
			xdg-terminal-exec -- "$@"
			;;
	esac
	exit $?
fi

TRY_TERMINAL_CMD=""
TRY_TERMINAL_EXEC_ARG="-e"
# ( cmd... )
try_terminal() {
	DEBUG 1 "Trying terminal $TRY_TERMINAL_CMD $TRY_TERMINAL_EXEC_ARG ..."
	if ! command -v "$TRY_TERMINAL_CMD" ; then
		return
	fi
	DEBUG 1 "Using terminal $TRY_TERMINAL_CMD $TRY_TERMINAL_EXEC_ARG"
	if [ -z "$1" ] ; then
		"$TRY_TERMINAL_CMD"
		exit $?
	else
		case "$TRY_TERMINAL_EXEC_ARG" in
			"")
				"$TRY_TERMINAL_CMD" "$@"
				exit $?
				;;
			*-x*)
				"$TRY_TERMINAL_CMD" "$TRY_TERMINAL_EXEC_ARG" sh -c '"$@"' -- "$@"
				exit $?
				;;
			*)
				"$TRY_TERMINAL_CMD" "$TRY_TERMINAL_EXEC_ARG" "$@"
				exit $?
				;;
		esac
	fi
}

#( cmd... )
terminal_xfce() {
	DEBUG 1 "Trying xfce-open ..."
	if command -v "xfce-open" >/dev/null 2>/dev/null ; then
		DEBUG 1 "Using xfce-open --launch TerminalEmulator"
		xfce-open --launch TerminalEmulator "$@"
		exit $?
	fi
}

terminal_gsettings() {
	DEBUG 1 "Trying terminal from gesttings ..."
	term_schema="$1"; shift

	term_exec="$(gsettings get "${term_schema}" exec | sed -r "s/^'(.*)'$/\1/")"
	TRY_TERMINAL_EXEC_ARG="$(gsettings get "${term_schema}" exec-arg | sed -r "s/^'(.*)'$/\1/")"

	TRY_TERMINAL_CMD="$(command -v "$term_exec")"

	if [ -x "$TRY_TERMINAL_CMD" ] ; then
		DEBUG 1 "Found gsettings terminal, trying it ..."
		try_terminal "$@"
	fi
}

detectDE

case "$DE" in
	kde)
		TRY_TERMINAL_CMD="konsole"
		try_terminal "$@"
		;;
	gnome3|budgie)
		terminal_gsettings org.gnome.desktop.default-applications.terminal "$@"
		;;
	cinnamon)
		terminal_gsettings org.cinnamon.desktop.default-applications.terminal "$@"
		;;
	mate)
		terminal_gsettings org.mate.applications-terminal "$@"
		;;
	xfce)
		terminal_xfce "$@"
		;;
	lxde)
		TRY_TERMINAL_CMD="lxterminal"
		try_terminal "$@"
		;;
	lxqt)
		TRY_TERMINAL_CMD="qterminal"
		try_terminal "$@"
		;;
	enlightenment)
		TRY_TERMINAL_CMD="terminology"
		try_terminal "$@"
		;;
	*)
		true # use fallbacks
		;;
esac

# Fallback, one for Wayland, one for X
if [ -n "$WAYLAND_DISPLAY" ] && command -v foot >/dev/null 2>/dev/null ; then
	DEBUG 1 "Using foot"
	case "$FLAGS" in
		t)
			foot --title="$TERMINAL_TITLE" -- "$@"
			;;
		a)
			foot --app-id="$APP_ID" -- "$@"
			;;
		ta)
			foot --app-id="$APP_ID" --title="$TERMINAL_TITLE" -- "$@"
			;;
		*)
			foot -- "$@"
			;;
	esac
	exit $?
elif [ -n "$DISPLAY" ] && command -v xterm >/dev/null 2>/dev/null ; then
	DEBUG 1 "Using xterm"
	if [ -n "$TERMINAL_TITLE" ] ; then
		xterm -T "$TERMINAL_TITLE" -e "$@"
	else
		xterm -e "$@"
	fi
	exit $?
else
	exit_failure_operation_impossible "No useable terminal found!"
fi
