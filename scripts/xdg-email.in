#!/bin/sh
#---------------------------------------------
#   xdg-email
#
#   Utility script to open the users favorite email program, using the
#       RFC 2368 mailto: URI spec
#
#   Refer to the usage() function below for usage.
#
#   Copyright 2009-2010, Fathi Boudra <fabo@freedesktop.org>
#   Copyright 2009-2010, Rex Dieter <rdieter@fedoraproject.org>
#   Copyright 2006, Kevin Krammer <kevin.krammer@gmx.at>
#   Copyright 2006, Jeremy White <jwhite@codeweavers.com>
#
#   LICENSE:
#
#---------------------------------------------

manualpage()
{
cat << '_MANUALPAGE'
_MANUALPAGE
}

usage()
{
cat << '_USAGE'
_USAGE
}

#@xdg-utils-common@

# (thunderbird_binary, mailto_uri, attached_files)
run_thunderbird()
{
    local THUNDERBIRD MAILTO NEWMAILTO TO CC BCC SUBJECT BODY ATTACH
    THUNDERBIRD="$1"
    MAILTO="$(echo "$2" | sed 's/^mailto://')"
    ATTACH="$3"

    if printf '%s' "$MAILTO" | grep -qs "^?" ; then
        MAILTO="$(echo "$MAILTO" | sed 's/^?//')"
    else
        MAILTO="$(echo "$MAILTO" | sed 's/^/to=/' | sed 's/?/\&/')"
    fi

    DEBUG 1 "Special case: Thunderbird style for $THUNDERBIRD using '$MAILTO'"

    MAILTO="$(echo "$MAILTO" | tr '&' '\n' )"
    # This will not handle E-Mail adresses that contain , or ' very well, but at least it won't turn them into an injection attack.
    TO="$(printf "%s\n" "$MAILTO" | sed -n 's/^to=//p' | encode_thunderbird_argument_value_list )"
    CC="$(printf "%s\n" "$MAILTO" | sed -n 's/^cc=//p' | encode_thunderbird_argument_value_list )"
    BCC="$(printf "%s\n" "$MAILTO" | sed -n 's/^bcc=//p' | encode_thunderbird_argument_value_list )"
    # The long sed commands ensure that the important things get URL-encoded in strings that should already be URL-encoded
    SUBJECT="$(printf "%s\n" "$MAILTO" | sed -n 's/^subject=//p' | tail -n 1 | sed -e 's/,/%2c/g' -e 's/\o047/%27/g' -e 's/\o042/%22/g')"
    BODY="$(printf "%s\n" "$MAILTO" | sed -n 's/^body=//p' | tail -n 1 | sed -e 's/,/%2c/g' -e 's/\o047/%27/g' -e 's/\o042/%22/g' )"

    if [ -z "$TO" ] ; then
        NEWMAILTO=
    else
        NEWMAILTO="to=\"$TO\""
    fi
    if [ -n "$CC" ] ; then
        NEWMAILTO="${NEWMAILTO},cc=\"$CC\""
    fi
    if [ -n "$BCC" ] ; then
        NEWMAILTO="${NEWMAILTO},bcc=\"$BCC\""
    fi
    if [ -n "$SUBJECT" ] ; then
        NEWMAILTO="${NEWMAILTO},subject=$SUBJECT"
    fi
    if [ -n "$BODY" ] ; then
        NEWMAILTO="${NEWMAILTO},body=$BODY"
    fi

    if [ -n "$ATTACH" ] ; then
        NEWMAILTO="${NEWMAILTO},attachment='${ATTACH}'"
    fi

    NEWMAILTO=$(echo "$NEWMAILTO" | sed 's/^,//')
    DEBUG 1 "Running $THUNDERBIRD -compose \"$NEWMAILTO\""
    "$THUNDERBIRD" -compose "$NEWMAILTO"
    if [ $? -eq 0 ]; then
        exit_success
    else
        exit_failure_operation_failed
    fi
}

# (mailto_uri)
open_portal()
{
    gdbus call --session \
        --dest org.freedesktop.portal.Desktop \
        --object-path /org/freedesktop/portal/desktop \
        --method org.freedesktop.portal.OpenURI.OpenURI \
        "" "$1" {}

    if [ $? -eq 0 ]; then
        exit_success
    else
        exit_failure_operation_failed
    fi
}

# (mailto_uri, attach)
open_generic()
{
    local client
    local desktop
    desktop="$(xdg-mime query default "x-scheme-handler/mailto")"
    client="$(desktop_file_to_binary "$desktop")"
    case "$client" in *thunderbird*|*icedove*|*betterbird*)
        run_thunderbird "$client" "$1" "$2"
    esac

    xdg-open "$1"
    exit $?
}

# Takes text on stdin encoded in whatever iconv can recognize and spit out utf8
to_utf8()
{
	if [ -n "$assume_utf8" ] ; then
		cat
	else
		iconv -t utf8
	fi
}

# URL encodes the given text to stdout
#
# Multiple places rely on this encoding commata (,) and not encoding slashes (/)
# 
#(text)
url_encode() {
	printf "%s" "$1" | to_utf8 | raw_url_encode
}

# URL encode text from stdin to stdout, assumes UTF-8 encoding
#
# Multiple places rely on this encoding commata (,) and not encoding slashes (/)
#
# ()
raw_url_encode() {
# Note: the LANG=C and LC_ALL=C before the awk are there to make sure awk handles the text on a byte and not a codepoint level.
# See also: https://bugs.freedesktop.org/show_bug.cgi?id=13139
LANG=C LC_ALL=C awk '
    BEGIN {
        for ( i=1; i<=255; ++i ) ord [ sprintf ("%c", i) "" ] = i + 0
        e = ""
        linenr = 1
    }
    {
        if ( linenr++ != 1 ) {
            e = e "%0D%0A"
        }
        for ( i=1; i<=length ($0); ++i ) {
            c = substr ($0, i, 1)
            if ( ord [c] > 127 ) {
                e = e "%" sprintf("%02X", ord [c])
            } else if ( c ~ /[@a-zA-Z0-9.\-\\\/]/ ) {
                e = e c
            } else {
                e = e "%" sprintf("%02X", ord [c])
            }
        }
    }
    END {
        print e
    }
'
}

# Receives inputs as one input per line an encodes them as an argument list.
#
# Works as a filter
# ()
encode_thunderbird_argument_value_list() {
	while read -r LINE ; do
		printf '%s' "$LINE" | raw_url_encode
	done | awk '
	{
		print "*" $0 > "/dev/stderr"
		if (not_first) {
			printf ","
		} else {
			not_first = 1
		}
		printf("%s", $0)
	}'
}


options=
mailto=
# attach is a comma separated list of file URIs
attach=
assume_utf8=""
while [ $# -gt 0 ] ; do
    parm="$1"
    shift

    case "$parm" in
      --utf8)
        assume_utf8="y"
        ;;

      --to)
        if [ -z "$1" ] ; then
            exit_failure_syntax "email address argument missing for --to"
        fi
        options="${options}to=$( url_encode "$1" )&"
        shift
        ;;

      --cc)
        if [ -z "$1" ] ; then
             exit_failure_syntax "email address argument missing for --cc"
        fi
        options="${options}cc=$( url_encode "$1" )&"
        shift
        ;;

      --bcc)
        if [ -z "$1" ] ; then
            exit_failure_syntax "email address argument missing for --bcc"
        fi
        options="${options}bcc=$( url_encode "$1" )&"
        shift
        ;;

      --subject)
        if [ -z "$1" ] ; then
            exit_failure_syntax "text argument missing for --subject option"
        fi
        options="${options}subject=$( url_encode "$1" )&"
        shift
        ;;

      --body)
        if [ -z "$1" ] ; then
            exit_failure_syntax "text argument missing for --body option"
        fi
        options="${options}body=$( url_encode "$1" )&"
        shift
        ;;

      --attach)
        if [ -z "$1" ] ; then
            exit_failure_syntax "file argument missing for --attach option"
        fi
        check_input_file "$1"
        file="$(xdg_realpath "$1")" # Normalize path
        if [ -z "$file" ] || [ ! -f "$file" ] ; then
            exit_failure_file_missing "file '$1' does not exist"
        fi

        attach="${attach}${attach:+,}file://$( url_encode "$file" )"
        shift
        ;;

      -*)
        exit_failure_syntax "unexpected option '$parm'"
        ;;

      mailto:*)
        mailto="$parm"
        ;;

      *@*)
        if [ -z "${mailto}" ] ; then
            mailto="mailto:$( url_encode "$parm" )?"
        else
            options="${options}to=$( url_encode "$parm" )&"
        fi
        ;;

      *)
        exit_failure_syntax "unexpected argument '$parm'"
        ;;
    esac
done

if [ -z "${mailto}" ] ; then
    # TO address is optional
    mailto="mailto:?"
fi

# Merge mailto link with options from other CLI arguments
case $mailto in
      *\?)
        mailto="${mailto}${options}"
        ;;

      *\?*)
        mailto="${mailto}&${options}"
        ;;

      *)
        mailto="${mailto}?${options}"
        ;;
esac

# Strip trailing ? and &
mailto="$(echo "${mailto}"| sed 's/[?&]$//')"

# Either mailto is non-empty or we fail
[ -n "${mailto}" ] || exit_failure_syntax

if command -v @NAME@-hook.sh > /dev/null; then
	if [ -z "$attach" ] ; then
	    @NAME@-hook.sh "${mailto}"
	else
	    @NAME@-hook.sh "${mailto}" --attach-files "$attach"
	fi
    if [ $? -eq 0 ]; then
        exit_success
    else
        exit_failure_operation_failed
    fi
fi

detectDE

case "$DE" in
	flatpak|toolbx)
		if [ -z "$attach" ] ; then
			exit_failure_operation_impossible "Unable to use --attach from inside a $DE as support for the flatpak E-Mail portal has not been implemented in xdg-email yet. Contributions are welcome!"
		fi
		open_portal "${mailto}"
		;;

	*)
		open_generic "${mailto}" "$attach"
		;;
esac
